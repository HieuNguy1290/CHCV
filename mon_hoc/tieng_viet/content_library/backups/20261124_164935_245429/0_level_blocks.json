  {
    "id": "vi.block.animals.1",
    "theme": "animals",
    "level": 1,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Con mèo nằm bên cửa. | Con chó chạy ra sân. | Con vịt lội dưới ao.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.animals.2",
    "theme": "animals",
    "level": 2,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Con gà bới đất kiếm mồi. | Con cá bơi trong lu. | Con trâu đi chậm trên đường làng.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.animals.3",
    "theme": "animals",
    "level": 3,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Con bò ăn cỏ ngoài đồng. | Con chim đậu trên mái ngói. | Con bướm bay qua vườn.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.animals.4",
    "theme": "animals",
    "level": 4,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Con ong hút mật hoa. | Con kiến tha mồi về tổ. | Con ếch kêu sau cơn mưa.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.animals.5",
    "theme": "animals",
    "level": 5,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Con cua bò bên bờ mương. | Con tép nhỏ trong rổ. | Con dế gáy trong bụi cỏ.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
