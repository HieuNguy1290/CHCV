  {
    "id": "vi.block.fruits.1",
    "theme": "fruits",
    "level": 1,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Trái xoài chín thơm lừng. | Má mua một rổ trái ổi. | Trái mít có múi vàng.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.fruits.2",
    "theme": "fruits",
    "level": 2,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Trái mận đỏ giòn ngọt. | Trái bưởi có vỏ dày. | Trái dừa có nước mát.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.fruits.3",
    "theme": "fruits",
    "level": 3,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Nải chuối đặt trên bàn. | Trái cam chín mọng. | Trái quýt dễ lột vỏ.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.fruits.4",
    "theme": "fruits",
    "level": 4,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Chôm chôm có vỏ nhiều gai mềm. | Sầu riêng có mùi đặc trưng. | Trái nhãn mọc thành chùm.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.fruits.5",
