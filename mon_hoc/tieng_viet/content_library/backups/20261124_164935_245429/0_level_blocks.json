  {
    "id": "vi.block.actions.1",
    "theme": "actions",
    "level": 1,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Má đi chợ từ sớm. | Em xách giỏ giùm má. | Ngoại ngồi chơi ngoài hàng ba.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.actions.2",
    "theme": "actions",
    "level": 2,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Chiều nay cậu ghé thăm. | Cả nhà cùng dọn dẹp. | Em quét nhà sạch sẽ.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.actions.3",
    "theme": "actions",
    "level": 3,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Má nhờ em lặt rau. | Chị Ba vo gạo nấu cơm. | Ăn xong em rửa chén.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.actions.4",
    "theme": "actions",
    "level": 4,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Ba mở cửa đón khách. | Gió mạnh nên em khép cửa. | Ông ngồi đọc báo.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.actions.5",
    "theme": "actions",
    "level": 5,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Em thử viết một bài thơ. | Ba nghe đài buổi tối. | Sáng em tới trường.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
