  {
    "id": "vi.block.sports.1",
    "theme": "sports",
    "level": 1,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Lũ trẻ đá banh ở sân đất. | Trái banh lăn vô sân. | Em đạp xe ra đầu hẻm.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.sports.2",
    "theme": "sports",
    "level": 2,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Anh tập bơi lội ở hồ. | Các bạn chạy đua tới vạch. | Mấy chị em chơi nhảy dây.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.sports.3",
    "theme": "sports",
    "level": 3,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Sân banh gần trường. | Đội banh ra sân đúng giờ. | Ba dạy em đánh cầu lông.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.sports.4",
    "theme": "sports",
    "level": 4,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Cây vợt đặt ngay ngắn. | Buổi sớm em tập thể dục. | Em bắt banh bằng hai tay.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.sports.5",
    "theme": "sports",
    "level": 5,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Bạn chuyền banh qua phía tôi. | Cả đội reo khi bạn về đích. | Các đội thi đấu rất vui.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
