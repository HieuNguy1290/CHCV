  {
    "id": "vi.block.family.3",
    "theme": "Family & Friends",
    "level": 3,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Cậu ghé chơi buổi trưa. | Mợ đem bánh qua biếu ngoại. | Dì chỉ em đọc sách.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.family.4",
    "theme": "Family & Friends",
    "level": 4,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Chú vá chiếc xe đạp. | Thím đem giỏ ra chợ. | Cháu chào ông bà.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.family.5",
    "theme": "Family & Friends",
    "level": 5,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Cả xóm cùng dọn con hẻm. | Bữa cơm có canh chua. | Cả nhà ngồi mát ngoài hàng ba.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.family.6",
    "theme": "Family & Friends",
    "level": 6,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Má nấu cơm cho cả nhà. | Ba đọc báo ở hàng ba. | Chiều nay em sang thăm ngoại.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
    "id": "vi.block.family.7",
    "theme": "Family & Friends",
    "level": 7,
    "order": 1,
    "title": "Lời nói trong sinh hoạt",
    "content": "Nội kể chuyện hồi xưa. | Anh Hai đưa em đi học. | Chị Ba xếp tập vở.",
    "image": "",
    "schema_version": "2.1",
    "title_audio": "",
    "content_audio": "",
    "lesson": 1
  },
  {
