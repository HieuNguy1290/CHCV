#Requires -Version 5.1
<#
.SYNOPSIS
  Validates Claude Code skill folders (project and personal scope).
.PARAMETER ProjectPath
  Project root to inspect for .claude\skills. Defaults to the current directory.
.PARAMETER PersonalRoot
  Personal skills folder. Defaults to %USERPROFILE%\.claude\skills.
.OUTPUTS
  Exit code 0 when every skill is valid, 1 when at least one error was found.
#>
[CmdletBinding()]
param(
    [string]$ProjectPath = (Get-Location).Path,
    [string]$PersonalRoot = (Join-Path $env:USERPROFILE '.claude\skills')
)

$ErrorActionPreference = 'Stop'
$script:good = 0
$script:warn = 0
$script:bad = 0

function Get-Frontmatter {
    param([string]$File)
    $lines = @(Get-Content -LiteralPath $File -ErrorAction Stop)
    if ($lines.Count -lt 2) { return $null }
    if ($lines[0].Trim() -ne '---') { return $null }
    $end = 0
    for ($i = 1; $i -lt $lines.Count; $i++) {
        if ($lines[$i].Trim() -eq '---') { $end = $i; break }
    }
    if ($end -eq 0) { return $null }
    $map = @{}
    for ($i = 1; $i -lt $end; $i++) {
        if ($lines[$i] -match '^([A-Za-z0-9_-]+)\s*:\s*(.*)$') {
            $value = $Matches[2].Trim()
            if ($value.Length -gt 1) {
                $first = $value[0]
                $last = $value[$value.Length - 1]
                if (($first -eq '"' -and $last -eq '"') -or ($first -eq "'" -and $last -eq "'")) {
                    $value = $value.Substring(1, $value.Length - 2)
                }
            }
            $map[$Matches[1]] = $value
        }
    }
    return $map
}

function Test-Skill {
    param([string]$Folder, [string]$Scope)

    $leaf = Split-Path -Leaf $Folder
    $label = "{0}/{1}" -f $Scope, $leaf
    $files = @(Get-ChildItem -LiteralPath $Folder -File -ErrorAction SilentlyContinue)
    $skillFile = $files | Where-Object { $_.Name -eq 'SKILL.md' } | Select-Object -First 1

    if (-not $skillFile) {
        $script:bad++
        Write-Host ("  [FAIL] {0} : missing SKILL.md (exact case)" -f $label) -ForegroundColor Red
        return
    }

    $fm = Get-Frontmatter -File $skillFile.FullName
    if ($null -eq $fm) {
        $script:bad++
        Write-Host ("  [FAIL] {0} : broken or missing frontmatter" -f $label) -ForegroundColor Red
        return
    }

    $name = $fm['name']
    $desc = $fm['description']
    $isValid = $true

    if (-not $name) {
        $script:bad++
        $isValid = $false
        Write-Host ("  [FAIL] {0} : frontmatter has no name" -f $label) -ForegroundColor Red
    } elseif ($name -notmatch '^[a-z0-9]+(-[a-z0-9]+)*$') {
        $script:bad++
        $isValid = $false
        Write-Host ("  [FAIL] {0} : name '{1}' is not kebab-case" -f $label, $name) -ForegroundColor Red
    }

    if (-not $desc) {
        $script:bad++
        $isValid = $false
        Write-Host ("  [FAIL] {0} : frontmatter has no description" -f $label) -ForegroundColor Red
    } else {
        if ($desc.Length -gt 1024) {
            $script:bad++
            $isValid = $false
            Write-Host ("  [FAIL] {0} : description longer than 1024 chars" -f $label) -ForegroundColor Red
        }
        if ($desc -match '[<>]') {
            $script:bad++
            $isValid = $false
            Write-Host ("  [FAIL] {0} : description contains angle brackets" -f $label) -ForegroundColor Red
        }
        if ($desc -notmatch 'Use when') {
            $script:warn++
            Write-Host ("  [WARN] {0} : description has no 'Use when' trigger" -f $label) -ForegroundColor Yellow
        }
    }

    if ($isValid) {
        $script:good++
        Write-Host ("  [OK]   {0} -> /{1}" -f $label, $name) -ForegroundColor Green
    }
}

function Test-SkillsRoot {
    param([string]$Root, [string]$Scope)

    Write-Host ("{0}: {1}" -f $Scope, $Root) -ForegroundColor Cyan

    if (-not (Test-Path -LiteralPath $Root -PathType Container)) {
        Write-Host '  (no skills folder here)' -ForegroundColor DarkGray
        Write-Host ''
        return
    }

    $folders = @(Get-ChildItem -LiteralPath $Root -Directory -ErrorAction SilentlyContinue)
    if ($folders.Count -eq 0) {
        Write-Host '  (empty)' -ForegroundColor DarkGray
        Write-Host ''
        return
    }

    foreach ($folder in $folders) {
        Test-Skill -Folder $folder.FullName -Scope $Scope
    }
    Write-Host ''
}

Test-SkillsRoot -Root $PersonalRoot -Scope 'personal'
Test-SkillsRoot -Root (Join-Path $ProjectPath '.claude\skills') -Scope 'project'

Write-Host ("valid={0}  warnings={1}  errors={2}" -f $script:good, $script:warn, $script:bad)
Write-Host ("checked from: {0}" -f $ProjectPath)

if ($script:bad -gt 0) {
    Write-Host 'Fix the failures above, then restart the session.' -ForegroundColor Yellow
    exit 1
}

Write-Host 'All skills valid. Restart the session, then invoke /skill-name.' -ForegroundColor Green
exit 0
